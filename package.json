{
  "name": "chain-reaction",
  "private": true,
  "version": "0.4.0",
  "description": "Edge Causal Resilience Intelligence for Snapdragon-powered PCs",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "start": "node ./scripts/bootstrap.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "doctor": "node ./scripts/doctor.mjs",
    "clean": "node ./scripts/clean.mjs",
    "verify": "npm run doctor && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
